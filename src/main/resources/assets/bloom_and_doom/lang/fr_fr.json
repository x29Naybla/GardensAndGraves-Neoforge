  "bloom_and_doom.advancement.sun_shroom": "Champi-soleil",
  "bloom_and_doom.advancement.sun_shroom.desc": "When they're awake, they take 48 seconds to generate one Sun when adults, and 1 minute and 36 seconds when babies. Can be found in taiga villages",

  "bloom_and_doom.advancement.puff_shroom": "Champi-gnon",
